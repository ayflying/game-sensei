# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
vendor/

# Model artifacts (distributed separately at runtime, not in repo)
*.onnx
models/*.onnx

# onnxruntime native libs (shipped with release bundle)
onnxruntime*/

# Python training outputs
trainer/__pycache__/
trainer/*.pt
trainer/runs/
*.onnx

# Replays / logs / env
replays/
*.log
.env
.venv/
__pycache__/

# WorkBuddy 本地记忆/会话数据（含私有笔记，不入公开仓库）
.workbuddy/

# CodeGraph 本地索引（可随时 codegraph init -i 重建，不入库）
.codegraph/

# 本地 Ollama 模型库（体积大，仅本机测试用，不入库）
.ollama/

# 真机标定/排查产物：仓库根目录的截图与状态文件（随时可用 tools/ 下的脚本重跑）
/*.png
/*.jpg
/*.txt
/*.status
/*.ls

# git 仓库损坏时的应急备份目录（2026-09-13 事件遗留，不入库）
/.git_corrupt_backup_*/
