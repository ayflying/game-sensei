# 复制为项目根目录 .env 并填入真实配置；.env 不得提交。
# 渠道配置仅用于图片识别。地址支持 /v1 基址或完整 /chat/completions。
AIFERRY_BASE_URL=
AIFERRY_API_KEY=
# 按优先级排列的视觉模型，逗号分隔；不提供隐藏的默认模型。
AIFERRY_MODELS=

# 本地兜底：填写完整地址，或只填写本地 OLLAMA_PORT。
OLLAMA_BASE_URL=
OLLAMA_PORT=
OLLAMA_MODEL=

# 每次请求的超时时间。
VLM_TIMEOUT=120s
# 可选：渠道直连网络失败后的代理；本地 Ollama 不经过代理。
VLM_PROXY_URL=

# ---- 本地 OCR（界面文字识别，cmd/ocr）----
# 以下全部可选：不配也能跑（解释器自动探测、阈值用引擎默认），本地无密钥与远端地址。
# 解释器需装 rapidocr_onnxruntime；留空时按 PATH -> 受管 venv 顺序探测并逐个验证。
OCR_PYTHON=
# 单次识别超时；超时即重启子进程。
OCR_TIMEOUT=30s
# 空闲多久关掉常驻子进程；显式写 0 表示不自动关。
OCR_IDLE=5m
# 引擎阈值，留空用自带默认（0.5）；取值 0~1。
OCR_BOX_THRESH=
OCR_TEXT_SCORE=
